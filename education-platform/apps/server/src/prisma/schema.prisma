generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * =========================
 * USER
 * =========================
 */
model Users {
  id            String  @id @default(uuid()) @db.Uuid
  email         String  @unique @db.VarChar(255)
  password_hash String  @db.VarChar(255)
  username      String?
  full_name     String  @db.VarChar(255)

  avatarId            String?      @unique @db.Uuid
  avatar              Attachment?  @relation("UserAvatar", fields: [avatarId], references: [id])
  uploadedAttachments Attachment[] @relation("AttachmentUploader")
  gender              Gender?
  birthDate           DateTime?

  role UserRole @default(PARENT)

  provider   AuthProvider @default(LOCAL)
  providerId String?

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  parentLinks FamilyMember[] @relation("ParentRelation")
  memberLinks FamilyMember[] @relation("MemberRelation")

  parentTasks Task[] @relation("ParentTasks")

  memberAssignments TaskAssignment[] @relation("MemberAssignments")

  submissions   Submission[]
  notifications Notification[]
  aiGenerations AIGeneration[]
  auditLogs     AuditLog[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

/**
 * =========================
 * FAMILY
 * =========================
 */
model FamilyMember {
  id String @id @default(uuid()) @db.Uuid

  parentId String  @db.Uuid
  memberId String  @db.Uuid

  grade String? @db.VarChar(2) // "1" -> "12"

  nickname String?

  parent Users @relation("ParentRelation", fields: [parentId], references: [id], onDelete: Cascade)
  member Users @relation("MemberRelation", fields: [memberId], references: [id], onDelete: Cascade)

   interests Interest[]

  createdAt DateTime @default(now())

  @@unique([parentId, memberId])
  @@index([parentId])
  @@index([memberId])
  @@map("family_members")
}


/**
 * =========================
 * INTEREST
 * =========================
 */
model Interest {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  members FamilyMember[]
  createdAt DateTime         @default(now())

  @@map("interests")
}


/**
 * =========================
 * TASK
 * =========================
 */
model Task {
  id String @id @default(uuid()) @db.Uuid

  parentId String @db.Uuid

  title String
  note  String?

  assignedAt DateTime  @default(now())
  dueAt      DateTime?
  duration   String?
  aiGenerated Boolean @default(false)

  parent Users @relation("ParentTasks", fields: [parentId], references: [id], onDelete: Cascade)

  assignments TaskAssignment[]
  attachments TaskAttachment[]
  questions   TaskQuestion[]
  submissions Submission[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parentId])
  @@index([dueAt])
  @@map("tasks")
}

/**
 * =========================
 * ATTACHMENT
 * =========================
 */
model Attachment {
  id String @id @default(uuid()) @db.Uuid

  publicId String         @unique
  url      String
  fileName String
  mimeType String
  fileSize BigInt
  type     AttachmentType

  uploadedById String?  @db.Uuid
  uploadedBy   Users?   @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  avatarOf     Users?   @relation("UserAvatar")
  createdAt    DateTime @default(now())

  taskLinks       TaskAttachment[]
  submissionLinks SubmissionAttachment[]

  @@index([uploadedById])
  @@map("attachments")
}

/**
 * =========================
 * TASK ASSIGNMENT
 * =========================
 */
model TaskAssignment {
  id String @id @default(uuid()) @db.Uuid

  taskId   String @db.Uuid
  memberId String @db.Uuid

  status TaskStatus @default(ASSIGNED)

  assignedAt  DateTime  @default(now())
  viewedAt    DateTime?
  completedAt DateTime?

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  member Users @relation("MemberAssignments", fields: [memberId], references: [id], onDelete: Cascade)

  submissions Submission[]

  @@unique([taskId, memberId])
  @@index([memberId, status])
  @@index([taskId])
  @@map("task_assignments")
}

/**
 * =========================
 * TASK ATTACHMENT
 * =========================
 */
model TaskAttachment {
  taskId       String @db.Uuid
  attachmentId String @db.Uuid

  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@id([taskId, attachmentId])
  @@map("task_attachments")
}

/**
 * =========================
 * SUBMISSION ATTACHMENT
 * =========================
 */
model SubmissionAttachment {
  submissionId String @db.Uuid
  attachmentId String @db.Uuid

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@id([submissionId, attachmentId])
  @@map("submission_attachments")
}

/**
 * =========================
 * TASK QUESTION
 * =========================
 */
model TaskQuestion {
  id String @id @default(uuid()) @db.Uuid

  taskId       String       @db.Uuid
  questionNo   Int
  questionType QuestionType

  content       String
  correctAnswer String?
  explanation   String?
  score         Float   @default(1)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  options QuestionOption[]
  answers SubmissionAnswer[]

  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_questions")
}

/**
 * =========================
 * QUESTION OPTION
 * =========================
 */
model QuestionOption {
  id String @id @default(uuid()) @db.Uuid

  questionId    String  @db.Uuid
  optionKey     String
  optionContent String
  isCorrect     Boolean @default(false)

  question TaskQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}

/**
 * =========================
 * SUBMISSION
 * =========================
 */
model Submission {
  id String @id @default(uuid()) @db.Uuid

  taskId       String @db.Uuid
  assignmentId String @db.Uuid
  memberId     String @db.Uuid

  submissionNo Int              @default(1)
  note         String?
  status       SubmissionStatus @default(DRAFT)
  submittedAt  DateTime?

  task       Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignment TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  member     Users          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  attachments SubmissionAttachment[]
  answers     SubmissionAnswer[]
  analyses    AIAnalysis[]

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([memberId, status])
  @@map("submissions")
}

/**
 * =========================
 * SUBMISSION ANSWER
 * =========================
 */
model SubmissionAnswer {
  id String @id @default(uuid()) @db.Uuid

  submissionId String @db.Uuid
  questionId   String @db.Uuid

  answerContent String?
  aiScore       Float?
  aiFeedback    String?

  submission Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   TaskQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([questionId])
  @@map("submission_answers")
}

/**
 * =========================
 * NOTIFICATION
 * =========================
 */
model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  type    NotificationType
  title   String
  content String

  isRead Boolean   @default(false)
  readAt DateTime?

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

/**
 * =========================
 * AI GENERATION
 * =========================
 */
model AIGeneration {
  id String @id @default(uuid()) @db.Uuid

  parentId String  @db.Uuid
  taskId   String? @db.Uuid

  prompt          String
  generatedResult Json?
  modelName       String?

  parent Users @relation(fields: [parentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([parentId, createdAt])
}

/**
 * =========================
 * AI ANALYSIS
 * =========================
 */
model AIAnalysis {
  id String @id @default(uuid()) @db.Uuid

  submissionId String @db.Uuid

  score      Float?
  totalScore Float?
  accuracy   Float?

  summary         String?
  strengths       String?
  weaknesses      String?
  recommendations String?

  analysisJson Json?

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([submissionId])
}

/**
 * =========================
 * AUDIT LOG
 * =========================
 */
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  userId String? @db.Uuid

  action     String
  entityName String
  entityId   String? @db.Uuid

  oldData   Json?
  newData   Json?
  ipAddress String?

  user Users? @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/**
 * =========================
 * ENUMS
 * =========================
 */

enum UserRole {
  PARENT
  MEMBER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum TaskStatus {
  ASSIGNED
  VIEWED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_VIEWED
  TASK_COMPLETED
  NEW_SUBMISSION
  AI_ANALYSIS
}

enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
}

enum AttachmentType {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  OTHER
}
