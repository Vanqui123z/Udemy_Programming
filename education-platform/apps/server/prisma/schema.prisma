generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model answers {
  id                   String                 @id @db.Uuid
  question_id          String?                @db.Uuid
  content              String?
  is_correct           Boolean?
  created_at           DateTime?              @db.Timestamp(6)
  updated_at           DateTime?              @db.Timestamp(6)
  questions            questions?             @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quiz_attempt_answers quiz_attempt_answers[]
}

model categories {
  id         String    @id @db.Uuid
  name       String    @db.VarChar(100)
  created_at DateTime? @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)
  courses    courses[]
}

model conversation_participants {
  conversation_id String        @db.Uuid
  user_id         String        @db.Uuid
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([conversation_id, user_id])
}

model conversations {
  id                        String                      @id @db.Uuid
  created_at                DateTime?                   @db.Timestamp(6)
  conversation_participants conversation_participants[]
  messages                  messages[]
}

model courses {
  id            String        @id @db.Uuid
  category_id   String?       @db.Uuid
  teacher_id    String?       @db.Uuid
  title         String        @db.VarChar(255)
  slug          String        @unique @db.VarChar(255)
  description   String?
  thumbnail_url String?
  level         String?       @db.VarChar(50)
  is_published  Boolean?      @default(false)
  created_at    DateTime?     @db.Timestamp(6)
  updated_at    DateTime?     @db.Timestamp(6)
  categories    categories?   @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users         users?        @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollments   enrollments[]
  reviews       reviews[]
  sections      sections[]
}

model enrollments {
  id          String    @id @db.Uuid
  user_id     String?   @db.Uuid
  course_id   String?   @db.Uuid
  enrolled_at DateTime? @db.Timestamp(6)
  courses     courses?  @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, course_id])
}

model files {
  id          String    @id @db.Uuid
  uploader_id String?   @db.Uuid
  file_name   String?   @db.VarChar(255)
  file_url    String?
  file_size   BigInt?
  mime_type   String?   @db.VarChar(100)
  created_at  DateTime? @db.Timestamp(6)
  users       users?    @relation(fields: [uploader_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model lessons {
  id               String     @id @db.Uuid
  section_id       String?    @db.Uuid
  title            String?    @db.VarChar(255)
  description      String?
  video_url        String?
  duration_seconds Int?
  sort_order       Int?
  created_at       DateTime?  @db.Timestamp(6)
  updated_at       DateTime?  @db.Timestamp(6)
  sections         sections?  @relation(fields: [section_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  progress         progress[]
  quizzes          quizzes[]
}

model messages {
  id              String         @id @db.Uuid
  conversation_id String?        @db.Uuid
  sender_id       String?        @db.Uuid
  content         String?
  created_at      DateTime?      @db.Timestamp(6)
  conversations   conversations? @relation(fields: [conversation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users?         @relation(fields: [sender_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model notifications {
  id         String    @id @db.Uuid
  user_id    String?   @db.Uuid
  title      String?   @db.VarChar(255)
  content    String?
  is_read    Boolean?  @default(false)
  created_at DateTime? @db.Timestamp(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model progress {
  id             String    @id @db.Uuid
  user_id        String?   @db.Uuid
  lesson_id      String?   @db.Uuid
  current_second Int?      @default(0)
  completed      Boolean?  @default(false)
  completed_at   DateTime? @db.Timestamp(6)
  created_at     DateTime? @db.Timestamp(6)
  updated_at     DateTime? @db.Timestamp(6)
  lessons        lessons?  @relation(fields: [lesson_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users          users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, lesson_id])
}

model questions {
  id                   String                 @id @db.Uuid
  quiz_id              String?                @db.Uuid
  content              String?
  sort_order           Int?
  created_at           DateTime?              @db.Timestamp(6)
  updated_at           DateTime?              @db.Timestamp(6)
  answers              answers[]
  quizzes              quizzes?               @relation(fields: [quiz_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quiz_attempt_answers quiz_attempt_answers[]
}

model quiz_attempt_answers {
  id            String         @id @db.Uuid
  attempt_id    String?        @db.Uuid
  question_id   String?        @db.Uuid
  answer_id     String?        @db.Uuid
  answers       answers?       @relation(fields: [answer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quiz_attempts quiz_attempts? @relation(fields: [attempt_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  questions     questions?     @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model quiz_attempts {
  id                   String                 @id @db.Uuid
  quiz_id              String?                @db.Uuid
  user_id              String?                @db.Uuid
  score                Decimal?               @db.Decimal(5, 2)
  submitted_at         DateTime?              @db.Timestamp(6)
  created_at           DateTime?              @db.Timestamp(6)
  quiz_attempt_answers quiz_attempt_answers[]
  quizzes              quizzes?               @relation(fields: [quiz_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                users?                 @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model quizzes {
  id            String          @id @db.Uuid
  lesson_id     String?         @db.Uuid
  title         String?         @db.VarChar(255)
  passing_score Int?            @default(70)
  created_at    DateTime?       @db.Timestamp(6)
  updated_at    DateTime?       @db.Timestamp(6)
  questions     questions[]
  quiz_attempts quiz_attempts[]
  lessons       lessons?        @relation(fields: [lesson_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model reviews {
  id         String    @id @db.Uuid
  course_id  String?   @db.Uuid
  user_id    String?   @db.Uuid
  rating     Int?
  comment    String?
  created_at DateTime? @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)
  courses    courses?  @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model sections {
  id         String    @id @db.Uuid
  course_id  String?   @db.Uuid
  title      String?   @db.VarChar(255)
  sort_order Int?
  created_at DateTime? @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)
  lessons    lessons[]
  courses    courses?  @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  id                        String                      @id @db.Uuid
  email                     String                      @unique @db.VarChar(255)
  password_hash             String                      @db.VarChar(255)
  full_name                 String                      @db.VarChar(255)
  avatar_url                String?
  role                      String                      @db.VarChar(20)
  created_at                DateTime?                   @db.Timestamp(6)
  updated_at                DateTime?                   @db.Timestamp(6)
  conversation_participants conversation_participants[]
  courses                   courses[]
  enrollments               enrollments[]
  files                     files[]
  messages                  messages[]
  notifications             notifications[]
  progress                  progress[]
  quiz_attempts             quiz_attempts[]
  reviews                   reviews[]
}
